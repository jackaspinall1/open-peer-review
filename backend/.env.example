# Copy to backend/.env and fill in. Real environment variables override these.

# mock = dev login form only | orcid = real ORCID sign-in only | both = both
AUTH_MODE=both

# From https://orcid.org/developer-tools after registering a public API client.
# The client's registered redirect URI must be EXACTLY:
#   http://localhost:5173/auth/orcid/callback
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
# production (default) or sandbox (sandbox.orcid.org)
ORCID_ENV=production
ORCID_REDIRECT_URI=http://localhost:5173/auth/orcid/callback

# Long random string; required for stable sessions across restarts
SECRET_KEY=dev-secret-change-me

# Joins OpenAlex's polite (faster) pool for COI checks
OPENALEX_MAILTO=
